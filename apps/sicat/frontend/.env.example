VITE_API_BASE_URL=http://127.0.0.1:8080
VITE_REQUIRE_REAL_AUTH=true
# Nunca pré-preencher credencial: o campo de e-mail do login começa sempre vazio
# (o preenchimento fica a cargo do gerenciador de senhas do usuário).
VITE_LOGIN_PARTNER_CODE=

# Feature flag da vertical Transporte (DL-103, programa "SICAT Transporte",
# Onda 1.5/PR-F1 — frontend mínimo atrás de flag). Default DESLIGADO — nunca
# setar em produção enquanto o programa não passar da Fase A. Descomente para
# ligar em dev local (grupo de navegação "Transporte" + rotas /transporte/*).
# VITE_FEATURE_TRANSPORTE=true
